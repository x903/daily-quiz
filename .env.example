# ============================================================================
# 本地配置模板：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会入库）
#   cp .env.example .env
# docker compose 会自动读取同目录的 .env 做变量替换；
# db.py 也会读取 .env，因此本机直接 `python app.py` 同样生效。
# ============================================================================

# 数据库后端：mysql（生产/Docker）/ sqlite（无 MySQL 服务时的本地回退）
DB_BACKEND=mysql

# ---- MySQL 连接（DATABASE_URL 与 MYSQL_* 二选一，前者优先）----
# DATABASE_URL=mysql://quiz:quizpass@127.0.0.1:3306/daily_quiz
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=quiz
MYSQL_PASSWORD=quizpass
MYSQL_DATABASE=daily_quiz

# 仅 docker compose 的 db 服务用于初始化 root 密码；应用本身用上面的普通账号
MYSQL_ROOT_PASSWORD=rootpass

# 启动等待 MySQL 就绪（次数 × 间隔秒）
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_DELAY=2

# ---- Web ----
# Flask session 签名密钥：生产环境必须设置，且不要用示例值。
# 该值一旦泄露，任何人都能伪造管理员会话；docker-compose 已改为强制要求。
# 生成方式：openssl rand -hex 32
SECRET_KEY=请替换为随机字符串_至少32位
# 宿主机映射到 web 容器的端口
WEB_PORT=5000

# ---- 安全开关（上线默认值）----
# HTTPS 部署设为 1；留 auto 时按 SITE_BASE_URL 是否 https 自动判断
COOKIE_SECURE=auto
# 反向代理层数：单层 nginx 填 1；直连（无代理）填 0。
# 填 0 时完全忽略 X-Forwarded-For，防止伪造该头绕过登录锁定与验证码限流。
TRUST_PROXY_COUNT=0
# 同源校验的额外可信来源，逗号分隔；仅在反向代理改写 Host 时需要
# CSRF_TRUSTED_ORIGINS=https://www.example.com,https://example.com
# 单次请求体上限（MB），题库导入为纯 Markdown，8MB 足够
MAX_UPLOAD_MB=8

# ---- 个人中心：找回密码与验证码 ----
# 站点根地址：canonical / og:url / sitemap / 重置邮件链接都用它。
# 部署到域名后必须改成 https://your-domain，否则搜索引擎会把 localhost 当成正式地址。
SITE_BASE_URL=http://localhost:5000

# 开发模式：未配置邮件 / 短信网关时，验证码与重置链接会写日志并回显到接口，
# 方便本地验收。**生产环境默认关闭**（docker-compose 显式传 0）。
# 只有本地 SQLite 调试才需要打开：ACCOUNT_DEV_MODE=1
# ACCOUNT_DEV_MODE=1

# 邮件（SMTP）。MAIL_HOST / MAIL_FROM 都填了才会真实发信
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_SSL=1
# MAIL_STARTTLS=0
# MAIL_USER=no-reply@example.com
# MAIL_PASSWORD=your-smtp-password
# MAIL_FROM=no-reply@example.com

# 短信网关：向该地址 POST JSON {"phone": "...", "content": "..."}
# SMS_WEBHOOK_URL=https://sms-gateway.example.com/send
# SMS_WEBHOOK_TOKEN=your-gateway-token

# ---- 登录图形验证码 / 限流（Redis）----
# 验证码明文、失败计数、锁定标记都存这里，多 worker / 多实例共享。
# docker compose 会自动拉起 redis 服务；本机直接跑可指向本地 Redis。
# docker compose 默认注入 redis://redis:6379/0（服务名）；本机直跑再打开下面这行
# REDIS_URL=redis://127.0.0.1:6379/0
# 验证码有效期（秒）
CAPTCHA_TTL_SECONDS=300
# 同一 IP 在窗口期内最多取几张验证码（用户端；管理端固定为 20，见 admin_api.py）
CAPTCHA_RATE_LIMIT=5
CAPTCHA_RATE_WINDOW=300
# 连续登录失败几次后锁定，以及锁定时长（秒）；用户端与管理端各自计数
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

# ---- 用户名规则 ----
# 固定为 4-20 位、字母/数字/下划线/点号；保留词与规则写在 auth.py

# ---- 管理员初始账号（仅首次建库时生效）----
# 密码规则：至少 8 位，必须同时包含字母与数字。
# 已有库如果仍是 admin123 / user123，启动时会自动替换成这里配置的密码。
# 留空则随机生成并打印一次到容器日志（docker compose logs -f web）。
# 变量名故意用 ADMIN_INITIAL_PASSWORD：compose 会映射为容器内的 ADMIN_PASSWORD，
# 而本机直接 `python app.py` 时不会被 db.py 读到，不影响本地回归测试。
# ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=换成你自己的强密码123
