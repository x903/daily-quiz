# 版本控制 / IDE
.git
.gitignore
.idea
.vscode

# 本地虚拟环境与 Python 缓存
.venv
venv
env
__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# 本地密钥与环境变量（镜像内由 docker-compose 注入）
.env
.env.*
!.env.example

# 本地数据库文件（Docker 部署使用 MySQL，不打包 SQLite 库）
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db
data/*.db-*

# 回归测试脚本与文档（生产镜像无需携带）
test_*.py
*.log
*.tmp
*.bak
docker-compose.override.yml
